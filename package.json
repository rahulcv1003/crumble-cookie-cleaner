{
  "name": "crumble",
  "version": "0.2.0",
  "private": true,
  "description": "Crumble: Auto-Delete Cookies on Tab Close (Chrome extension, Manifest V3)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:test && playwright test",
    "test": "npm run typecheck && npm run lint && npm run build && npm run test:unit && npm run test:e2e",
    "screenshots": "node scripts/capture.mjs screenshots",
    "icons": "node scripts/icons.mjs",
    "package": "node scripts/package.mjs",
    "site": "node scripts/site.mjs",
    "store-assets": "npm run site && node scripts/capture.mjs store-assets"
  },
  "dependencies": {
    "punycode": "2.3.1",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
